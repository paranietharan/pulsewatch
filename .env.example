# ==============================================================================
# PulseWatch - Environment Configuration
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch_secret
POSTGRES_DB=pulsewatch
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

# Direct connection URL (used by Go services, Python migrations, etc.)
DATABASE_URL=postgres://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch?sslmode=disable

# RabbitMQ Message Broker Configuration
RABBITMQ_DEFAULT_USER=pulsewatch
RABBITMQ_DEFAULT_PASS=pulsewatch_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pulsewatch:pulsewatch_secret@localhost:5672/

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# API Service Configuration
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET=9h66d7LVUnjNeiMmtIATk3vaiwYIH5iHurEaa7SYYFe
ENVIRONMENT=development
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000
CLIENT_IP_STRATEGY=remote_addr
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_CIDRS=
CLIENT_IP_TRUSTED_PROXIES=1

# Notification Service Configuration & Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PulseWatch <alerts@pulsewatch.dev>
MAILPIT_PORT=8025
MAILPIT_WEB_URL=http://localhost:8025

# Probe Worker & Scheduler Configuration
PROBE_WORKER_CONCURRENCY=20
PROBE_WORKER_PREFETCH=20
PROBE_REGION=default
ALLOW_INTERNAL_PROBES=false
SCHEDULER_INTERVAL=5s
SCHEDULER_BATCH_SIZE=100

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
