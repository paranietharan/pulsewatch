# ==============================================================================
# PulseWatch - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local or production environment.

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=pulsewatch_secret
POSTGRES_DB=pulsewatch
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

# Direct connection URL (used by Go services, Python migrations, etc.)
DATABASE_URL=postgres://pulsewatch:pulsewatch_secret@localhost:5432/pulsewatch?sslmode=disable

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=pulsewatch
RABBITMQ_DEFAULT_PASS=pulsewatch_secret
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://pulsewatch:pulsewatch_secret@localhost:5672/

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# API Service Configuration (pulsewatch-api)
# ------------------------------------------------------------------------------
API_PORT=8080
API_HOST=0.0.0.0
JWT_SECRET=9h66d7LVUnjNeiMmtIATk3vaiwYIH5iHurEaa7SYYFe
ENVIRONMENT=development
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:3000

# Client IP Resolution Strategy (replaces deprecated chi RealIP)
# Options:
#   - remote_addr: Direct internet access, no reverse proxy (chi middleware.ClientIPFromRemoteAddr)
#   - cloudflare: Behind Cloudflare CDN (chi middleware.ClientIPFromHeader("CF-Connecting-IP"))
#   - header: Custom trusted header (chi middleware.ClientIPFromHeader("..."))
#   - xff: Behind a proxy with known IP ranges (chi middleware.ClientIPFromXFF("trusted CIDRs"))
#   - proxy_hops: Fixed number of trusted proxy hops (chi middleware.ClientIPFromXFFTrustedProxies(n))
CLIENT_IP_STRATEGY=remote_addr
CLIENT_IP_HEADER=
CLIENT_IP_TRUSTED_CIDRS=
CLIENT_IP_TRUSTED_PROXIES=1

# ------------------------------------------------------------------------------
# Notification Service Configuration (pulsewatch-notification-service)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@pulsewatch.dev
